<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sirampog PMD - Monev</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            touch-action: manipulation;
        }

        /* Pulsing animation for Marker A */
        .pulse-marker-a {
            background-color: #10b981;
            border-radius: 50%;
            border: 3px solid #ffffff;
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            animation: pulse-a 1.5s infinite;
        }

        @keyframes pulse-a {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            }
            70% {
                transform: scale(1.1);
                box-shadow: 0 0 0 14px rgba(16, 185, 129, 0);
            }
            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
            }
        }

        .marker-pin-b {
            background-color: #ef4444;
            border-radius: 50%;
            border: 3px solid #ffffff;
            box-shadow: 0 0 10px rgba(239, 68, 68, 0.8);
        }

        /* Custom Leaflet Map styling in dark mode */
        .leaflet-container {
            background-color: #0f172a !important;
            font-family: 'Inter', sans-serif !important;
        }

        /* Printable layout */
        @media print {
            body {
                background: white !important;
                color: black !important;
            }
            header, nav, #camera-section, #form-section, .no-print {
                display: none !important;
            }
            #print-report {
                display: block !important;
            }
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased pb-12">

    <!-- Header Lapangan (High-Contrast Outdoor View) -->
    <header class="bg-slate-900 border-b border-slate-800 p-4 sticky top-0 z-50 shadow-lg flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <div class="bg-amber-500 text-slate-950 p-2.5 rounded-xl font-black shadow-md shadow-amber-500/20">
                <i class="fa-solid fa-road text-xl"></i>
            </div>
            <div>
                <h1 class="font-extrabold text-base leading-tight text-white tracking-wide">RoadMonev GPS Tracker</h1>
                <p class="text-xs text-amber-400 font-semibold">Pengukur Jarak & Dokumentasi Jalan</p>
            </div>
        </div>
        <div class="flex items-center space-x-2">
            <button id="btn-info" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-3 py-2 rounded-xl text-xs font-semibold transition border border-slate-700 flex items-center space-x-1">
                <i class="fa-solid fa-circle-info text-amber-400"></i>
                <span class="hidden sm:inline">Panduan</span>
            </button>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-lg w-full mx-auto p-4 space-y-4">

        <!-- Form Identitas Ruas / STA -->
        <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 shadow-md space-y-3">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-map-location-dot text-amber-400"></i>
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-300">Informasi Ruas & Lokasi</h2>
                </div>
                <span id="gps-accuracy-badge" class="text-[10px] bg-slate-800 border border-slate-700 px-2 py-0.5 rounded-full text-slate-400 font-semibold">
                    <i class="fa-solid fa-satellite text-amber-400 mr-1"></i> Mencari GPS...
                </span>
            </div>

            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-[11px] text-slate-400 mb-1 font-medium">Nama Ruas / Proyek</label>
                    <input type="text" id="input-ruas" placeholder="Contoh: Jl. Raya Pantura Km 12" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-amber-400">
                </div>
                <div>
                    <label class="block text-[11px] text-slate-400 mb-1 font-medium">STA / Segmen</label>
                    <input type="text" id="input-sta" placeholder="Contoh: STA 0+100 - 0+350" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-amber-400">
                </div>
            </div>
        </div>

        <!-- Section Peta Interaktif Leaflet -->
        <div class="bg-slate-900 p-3 rounded-2xl border border-slate-800 space-y-2">
            <div class="flex justify-between items-center px-1">
                <span class="text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
                    <i class="fa-solid fa-map text-amber-400"></i> Peta Segmen Real-Time
                </span>
                <div class="flex items-center space-x-1">
                    <button id="btn-layer-street" class="bg-indigo-600 text-white text-[10px] font-bold px-2 py-1 rounded-lg">Peta Jalan</button>
                    <button id="btn-layer-sat" class="bg-slate-800 text-slate-400 text-[10px] font-bold px-2 py-1 rounded-lg">Satelit</button>
                </div>
            </div>

            <!-- Leaflet Container -->
            <div id="map" class="w-full h-64 rounded-xl border border-slate-800 z-10 overflow-hidden shadow-inner"></div>
        </div>

        <!-- Section Live Camera Preview & Snapshots -->
        <div id="camera-section" class="bg-slate-900 p-3 rounded-2xl border border-slate-800 space-y-3">
            <div class="relative bg-black rounded-xl overflow-hidden border border-slate-800 h-52 flex items-center justify-center">
                <!-- Live Video Feed -->
                <video id="camera-feed" autoplay playsinline muted class="w-full h-full object-cover hidden"></video>

                <!-- Initial Camera Button -->
                <div id="camera-placeholder" class="text-center p-4 space-y-2">
                    <i class="fa-solid fa-camera text-3xl text-slate-600"></i>
                    <p class="text-xs text-slate-400 max-w-[200px] mx-auto">Aktifkan kamera untuk dokumentasi visual titik jalan.</p>
                    <button id="btn-start-camera" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-lg transition">
                        <i class="fa-solid fa-power-off mr-1.5"></i> Buka Kamera HP
                    </button>
                </div>

                <!-- Hidden Canvas for Frame Capture -->
                <canvas id="snapshot-canvas" class="hidden"></canvas>

                <!-- Indicator Camera Status -->
                <div id="camera-live-badge" class="absolute top-3 left-3 bg-red-600/90 text-white text-[10px] font-bold px-2.5 py-1 rounded-full flex items-center space-x-1 hidden">
                    <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
                    <span>LIVE CAMERA</span>
                </div>
            </div>

            <!-- Preview Hasil Foto Titik A & B -->
            <div class="grid grid-cols-2 gap-2">
                <div class="bg-slate-950 p-2 rounded-xl border border-slate-800 flex items-center space-x-2">
                    <div id="thumb-a-container" class="w-10 h-10 bg-slate-900 border border-slate-800 rounded-lg overflow-hidden flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-image text-slate-700 text-sm"></i>
                    </div>
                    <div class="overflow-hidden">
                        <span class="text-[10px] font-bold text-emerald-400 block">Foto Titik A</span>
                        <span id="text-photo-a-status" class="text-[9px] text-slate-500 block truncate">Belum ada foto</span>
                    </div>
                </div>

                <div class="bg-slate-950 p-2 rounded-xl border border-slate-800 flex items-center space-x-2">
                    <div id="thumb-b-container" class="w-10 h-10 bg-slate-900 border border-slate-800 rounded-lg overflow-hidden flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-image text-slate-700 text-sm"></i>
                    </div>
                    <div class="overflow-hidden">
                        <span class="text-[10px] font-bold text-red-400 block">Foto Titik B</span>
                        <span id="text-photo-b-status" class="text-[9px] text-slate-500 block truncate">Belum ada foto</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Banner Counter Hasil Jarak -->
        <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 p-4 rounded-2xl border border-amber-500/30 text-center shadow-xl space-y-1 relative overflow-hidden">
            <div class="absolute -right-4 -bottom-4 opacity-10 text-amber-400 text-7xl font-black">
                <i class="fa-solid fa-ruler"></i>
            </div>
            <span class="text-[11px] font-bold tracking-widest text-slate-400 uppercase">Jarak Segmen Jalan (A ➔ B)</span>
            <div id="calculated-distance" class="text-4xl font-black text-amber-400 tracking-tight">
                0.00 <span class="text-base font-medium text-slate-300">meter</span>
            </div>
            <p id="distance-km-sub" class="text-[11px] text-slate-400 font-semibold">(0.000 km)</p>
        </div>

        <!-- Tombol Aksi Kontrol GPS (Set Titik A & B) -->
        <div class="grid grid-cols-2 gap-3">
            <button id="btn-point-a" class="bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-black py-3.5 px-3 rounded-2xl shadow-lg text-xs flex flex-col items-center justify-center space-y-1 border border-emerald-400/30 transition">
                <div class="flex items-center space-x-1.5">
                    <i class="fa-solid fa-location-dot text-amber-300 text-base"></i>
                    <span class="tracking-wider">1. SET TITIK AWAL (A)</span>
                </div>
                <span id="coord-a-text" class="text-[10px] font-normal text-emerald-100">Belum Ditandai</span>
            </button>

            <button id="btn-point-b" class="bg-red-600 hover:bg-red-500 active:scale-95 text-white font-black py-3.5 px-3 rounded-2xl shadow-lg text-xs flex flex-col items-center justify-center space-y-1 border border-red-400/30 transition opacity-60 cursor-not-allowed" disabled>
                <div class="flex items-center space-x-1.5">
                    <i class="fa-solid fa-flag-checkered text-amber-300 text-base"></i>
                    <span class="tracking-wider">2. SET TITIK AKHIR (B)</span>
                </div>
                <span id="coord-b-text" class="text-[10px] font-normal text-red-100">Belum Ditandai</span>
            </button>
        </div>

        <!-- Form Detail Temuan / Kerusakan Jalan -->
        <div id="form-section" class="bg-slate-900 p-4 rounded-2xl border border-slate-800 space-y-3">
            <div class="flex items-center space-x-2 border-b border-slate-800 pb-2">
                <i class="fa-solid fa-pen-to-square text-amber-400"></i>
                <h2 class="text-xs font-bold uppercase tracking-wider text-slate-300">Detail Temuan & Kerusakan</h2>
            </div>

            <div>
                <label class="block text-[11px] text-slate-400 mb-1 font-medium">Jenis Kerusakan / Temuan</label>
                <select id="select-finding-type" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-400">
                    <option value="Lubang Jalan (Pothole)">Lubang Jalan (Pothole)</option>
                    <option value="Retak Buaya (Alligator Cracking)">Retak Buaya (Alligator Cracking)</option>
                    <option value="Retak Memanjang / Melintang">Retak Memanjang / Melintang</option>
                    <option value="Longsor / Amblas (Subsidence)">Longsor / Amblas (Subsidence)</option>
                    <option value="Kerusakan Bahu Jalan">Kerusakan Bahu Jalan</option>
                    <option value="Pekerjaan Pengaspalan / Overlay">Pekerjaan Pengaspalan / Overlay</option>
                    <option value="Perbaikan Rigid Pavement">Perbaikan Rigid Pavement</option>
                    <option value="Kerusakan Saluran / Drainase">Kerusakan Saluran / Drainase</option>
                    <option value="Lainnya">Lainnya</option>
                </select>
            </div>

            <div>
                <label class="block text-[11px] text-slate-400 mb-1 font-medium">Catatan Tambahan / Keterangan Temuan</label>
                <textarea id="input-notes" rows="2" placeholder="Catat estimasi lebar/kedalaman, instruksi penanganan, atau kondisi fisik jalan..." class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-amber-400 resize-none"></textarea>
            </div>

            <button id="btn-save-log" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold py-3.5 rounded-xl shadow-lg transition flex items-center justify-center space-x-2 text-xs uppercase tracking-wider">
                <i class="fa-solid fa-floppy-disk text-sm"></i>
                <span>Simpan Hasil Monev Segmen Ini</span>
            </button>
        </div>

        <!-- Tabel Log Riwayat Monev -->
        <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 space-y-3">
            <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-list-check text-amber-400"></i>
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-300">Riwayat Pengukuran</h2>
                </div>
                <div class="flex items-center space-x-1.5">
                    <button id="btn-export-csv" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-2.5 py-1.5 rounded-lg text-[10px] font-bold border border-slate-700 flex items-center space-x-1">
                        <i class="fa-solid fa-file-csv text-emerald-400"></i>
                        <span>CSV</span>
                    </button>
                    <button id="btn-print-report" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-2.5 py-1.5 rounded-lg text-[10px] font-bold border border-slate-700 flex items-center space-x-1">
                        <i class="fa-solid fa-print text-indigo-400"></i>
                        <span>Cetak</span>
                    </button>
                </div>
            </div>

            <!-- List Container Log -->
            <div id="log-list-container" class="space-y-2.5 max-h-[350px] overflow-y-auto pr-1">
                <div id="empty-log-msg" class="text-center py-8 text-slate-600 text-xs">
                    <i class="fa-solid fa-folder-open text-3xl mb-2 block"></i>
                    Belum ada data segmen yang tersimpan.
                </div>
            </div>
        </div>

    </main>

    <!-- Printable Report View (Only Visible in Print Mode) -->
    <div id="print-report" class="hidden p-8 text-black bg-white">
        <div class="border-b-2 border-black pb-4 mb-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-black uppercase">Laporan Monev Jalan & Bangunan</h1>
                <p class="text-sm">Dokumentasi Pengukuran Jarak Segmen Berbasis GPS & Kamera</p>
            </div>
            <div class="text-right text-xs">
                <p>Tanggal Cetak: <span id="print-date"></span></p>
            </div>
        </div>

        <table class="w-full text-xs border-collapse border border-black mb-4">
            <thead>
                <tr class="bg-gray-200">
                    <th class="border border-black p-2">No</th>
                    <th class="border border-black p-2">Ruas / STA</th>
                    <th class="border border-black p-2">Jarak (m)</th>
                    <th class="border border-black p-2">Jenis Temuan</th>
                    <th class="border border-black p-2">Koordinat A & B</th>
                    <th class="border border-black p-2">Catatan</th>
                </tr>
            </thead>
            <tbody id="print-table-body">
                <!-- Dynamic Rows -->
            </tbody>
        </table>
    </div>

    <!-- Modal Panduan Penggunaan -->
    <div id="modal-info" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-sm w-full p-5 space-y-4 shadow-2xl text-xs">
            <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                <h3 class="font-bold text-sm text-white flex items-center">
                    <i class="fa-solid fa-circle-info text-amber-400 mr-2"></i>Panduan Monev Lapangan
                </h3>
                <button id="close-modal" class="text-slate-400 hover:text-white text-base"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="space-y-2.5 text-slate-300 leading-relaxed">
                <p><b>1. Buka Kamera HP:</b> Klik tombol "Buka Kamera HP" agar sistem merekam tampilan visual lokasi.</p>
                <p><b>2. Tandai Titik A (Awal):</b> Tekan tombol <b>"1. SET TITIK AWAL (A)"</b>. Marker hijau berkedip akan muncul di peta dan foto awal akan diambil.</p>
                <p><b>3. Berjalan ke Ujung Segmen:</b> Berjalanlah menyusuri jalan. Garis biru (*polyline*) akan otomatis ditarik mengikuti pergerakan GPS Anda secara real-time.</p>
                <p><b>4. Tandai Titik B (Akhir):</b> Tekan tombol <b>"2. SET TITIK AKHIR (B)"</b>. Marker merah akan dikunci dan total jarak otomatis dihitung dalam satuan meter/km.</p>
                <p><b>5. Simpan & Laporan:</b> Pilih jenis kerusakan, isi catatan, lalu simpan. Data bisa di-export ke CSV atau dicetak langsung.</p>
            </div>
            <button id="btn-close-modal" class="w-full bg-slate-800 hover:bg-slate-700 text-white font-bold py-2.5 rounded-xl border border-slate-700 transition">Tutup Panduan</button>
        </div>
    </div>

    <!-- Custom Alert Pop-up -->
    <div id="custom-alert" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-xs w-full p-4 space-y-3 text-center shadow-2xl">
            <div id="alert-icon" class="text-amber-400 text-3xl"><i class="fa-solid fa-circle-check"></i></div>
            <h4 id="alert-title" class="font-bold text-white text-sm">Informasi</h4>
            <p id="alert-message" class="text-xs text-slate-300">Pesan sistem...</p>
            <button onclick="closeCustomAlert()" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2 rounded-xl text-xs transition">OK</button>
        </div>
    </div>

    <!-- Application Script Logic -->
    <script>
        // State Global
        let map = null;
        let markerA = null;
        let markerB = null;
        let currentPosMarker = null;
        let polyline = null;
        let pathCoords = [];

        let cameraStream = null;
        let pointA = null; // { lat, lon, photo }
        let pointB = null; // { lat, lon, photo }
        let calculatedDistanceMeters = 0;
        let monevLogs = [];
        let lastKnownCoords = null;
        let watchPositionId = null;

        // Leaflet Tile Layers
        let streetLayer = null;
        let satLayer = null;

        // DOM Elements
        const videoElement = document.getElementById('camera-feed');
        const cameraPlaceholder = document.getElementById('camera-placeholder');
        const btnStartCamera = document.getElementById('btn-start-camera');
        const snapshotCanvas = document.getElementById('snapshot-canvas');
        const cameraLiveBadge = document.getElementById('camera-live-badge');

        const btnPointA = document.getElementById('btn-point-a');
        const btnPointB = document.getElementById('btn-point-b');
        const coordAText = document.getElementById('coord-a-text');
        const coordBText = document.getElementById('coord-b-text');
        const calculatedDistanceElem = document.getElementById('calculated-distance');
        const distanceKmSubElem = document.getElementById('distance-km-sub');
        const gpsAccuracyBadge = document.getElementById('gps-accuracy-badge');

        const thumbAContainer = document.getElementById('thumb-a-container');
        const thumbBContainer = document.getElementById('thumb-b-container');
        const textPhotoAStatus = document.getElementById('text-photo-a-status');
        const textPhotoBStatus = document.getElementById('text-photo-b-status');

        const inputRuas = document.getElementById('input-ruas');
        const inputSta = document.getElementById('input-sta');
        const selectFindingType = document.getElementById('select-finding-type');
        const inputNotes = document.getElementById('input-notes');
        const btnSaveLog = document.getElementById('btn-save-log');
        const logListContainer = document.getElementById('log-list-container');
        const emptyLogMsg = document.getElementById('empty-log-msg');

        // Initialize Application
        window.onload = function() {
            initLeafletMap();
            initGPS();
        };

        // 1. Inisialisasi Peta Leaflet.js
        function initLeafletMap() {
            // Center default di Jakarta/Indonesia jika belum ada GPS
            map = L.map('map', { zoomControl: false }).setView([-6.2088, 106.8456], 13);

            streetLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(map);

            satLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                maxZoom: 19,
                attribution: 'Tiles © Esri'
            });

            // Layer Toggle
            document.getElementById('btn-layer-street').addEventListener('click', () => {
                map.removeLayer(satLayer);
                map.addLayer(streetLayer);
                document.getElementById('btn-layer-street').className = "bg-indigo-600 text-white text-[10px] font-bold px-2 py-1 rounded-lg";
                document.getElementById('btn-layer-sat').className = "bg-slate-800 text-slate-400 text-[10px] font-bold px-2 py-1 rounded-lg";
            });

            document.getElementById('btn-layer-sat').addEventListener('click', () => {
                map.removeLayer(streetLayer);
                map.addLayer(satLayer);
                document.getElementById('btn-layer-sat').className = "bg-indigo-600 text-white text-[10px] font-bold px-2 py-1 rounded-lg";
                document.getElementById('btn-layer-street').className = "bg-slate-800 text-slate-400 text-[10px] font-bold px-2 py-1 rounded-lg";
            });

            // Initialize Polyline Path
            polyline = L.polyline([], { color: '#3b82f6', weight: 5, opacity: 0.8, dashArray: '5, 10' }).addTo(map);
        }

        // 2. Inisialisasi GPS Real-Time Watch Position
        function initGPS() {
            if ("geolocation" in navigator) {
                watchPositionId = navigator.geolocation.watchPosition(
                    (position) => {
                        const lat = position.coords.latitude;
                        const lon = position.coords.longitude;
                        const acc = Math.round(position.coords.accuracy);

                        lastKnownCoords = { lat, lon, acc };

                        gpsAccuracyBadge.innerHTML = `<i class="fa-solid fa-satellite text-emerald-400 mr-1"></i> Akurat: ±${acc}m`;

                        // Update Marker Posisi Sekarang jika sedang berjalan
                        const currentLatLng = [lat, lon];
                        
                        if (!currentPosMarker) {
                            currentPosMarker = L.circleMarker(currentLatLng, {
                                radius: 7,
                                fillColor: "#3b82f6",
                                color: "#ffffff",
                                weight: 2,
                                opacity: 1,
                                fillOpacity: 0.9
                            }).addTo(map);
                            map.setView(currentLatLng, 17);
                        } else {
                            currentPosMarker.setLatLng(currentLatLng);
                        }

                        // Jika Titik A sudah ditentukan dan Titik B belum, gambar garis jejak real-time!
                        if (pointA && !pointB) {
                            pathCoords.push(currentLatLng);
                            polyline.setLatLngs(pathCoords);
                            
                            // Hitung estimasi jarak sementara saat berjalan
                            const liveDist = calculateDistanceTwoPoints(pointA.lat, pointA.lon, lat, lon);
                            calculatedDistanceElem.innerHTML = `${liveDist.toFixed(2)} <span class="text-base font-medium text-slate-300">meter</span>`;
                            distanceKmSubElem.textContent = `(${(liveDist / 1000).toFixed(3)} km)`;
                        }
                    },
                    (error) => {
                        console.warn("GPS Error:", error.message);
                        gpsAccuracyBadge.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-amber-400 mr-1"></i> GPS Lemah`;
                    },
                    {
                        enableHighAccuracy: true,
                        timeout: 10000,
                        maximumAge: 0
                    }
                );
            } else {
                showAlert("GPS Tidak Didukung", "Browser perangkat Anda tidak mendukung geolokasi.");
            }
        }

        // 3. Kontrol Kamera Live Preview
        btnStartCamera.addEventListener('click', async () => {
            try {
                const constraints = {
                    video: {
                        facingMode: { ideal: "environment" },
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    }
                };

                try {
                    cameraStream = await navigator.mediaDevices.getUserMedia(constraints);
                } catch (e) {
                    cameraStream = await navigator.mediaDevices.getUserMedia({ video: true });
                }

                videoElement.srcObject = cameraStream;
                videoElement.classList.remove('hidden');
                cameraPlaceholder.classList.add('hidden');
                cameraLiveBadge.classList.remove('hidden');

            } catch (err) {
                console.error("Gagal membuka kamera:", err);
                showAlert("Akses Kamera Ditolak", "Pastikan izin kamera telah diberikan di browser.");
            }
        });

        // Frame Capture dari Kamera Video
        function capturePhoto() {
            if (!cameraStream || videoElement.classList.contains('hidden')) return null;
            snapshotCanvas.width = videoElement.videoWidth || 640;
            snapshotCanvas.height = videoElement.videoHeight || 480;
            const ctx = snapshotCanvas.getContext('2d');
            ctx.drawImage(videoElement, 0, 0, snapshotCanvas.width, snapshotCanvas.height);
            return snapshotCanvas.toDataURL('image/jpeg', 0.7);
        }

        // 4. Action: Set Titik Awal (A)
        btnPointA.addEventListener('click', () => {
            if (!lastKnownCoords) {
                showAlert("Mencari Sinyal GPS", "Mohon tunggu sejenak hingga posisi GPS terkunci.");
                return;
            }

            const photo = capturePhoto();
            pointA = {
                lat: lastKnownCoords.lat,
                lon: lastKnownCoords.lon,
                photo: photo
            };

            coordAText.textContent = `${pointA.lat.toFixed(5)}, ${pointA.lon.toFixed(5)}`;

            // UI Foto Preview A
            if (photo) {
                thumbAContainer.innerHTML = `<img src="${photo}" class="w-full h-full object-cover rounded-md">`;
                textPhotoAStatus.textContent = "Foto Terekam";
            }

            // Peta Marker A (Green Pulsing Icon)
            if (markerA) map.removeLayer(markerA);
            
            const customIconA = L.divIcon({
                className: 'pulse-marker-a',
                iconSize: [18, 18],
                iconAnchor: [9, 9]
            });

            markerA = L.marker([pointA.lat, pointA.lon], { icon: customIconA }).addTo(map)
                .bindPopup("<b>Titik Awal (A)</b>").openPopup();

            map.setView([pointA.lat, pointA.lon], 18);

            // Reset jalur jejak
            pathCoords = [[pointA.lat, pointA.lon]];
            polyline.setLatLngs(pathCoords);
            polyline.setStyle({ dashArray: null, color: '#3b82f6' });

            // Aktifkan Tombol Titik B
            btnPointB.disabled = false;
            btnPointB.classList.remove('opacity-60', 'cursor-not-allowed');

            showAlert("Titik Awal Terkunci", `Marker A diset di koordinat ${pointA.lat.toFixed(5)}, ${pointA.lon.toFixed(5)}. Sekarang berjalanlah ke Titik B.`);
        });

        // 5. Action: Set Titik Akhir (B)
        btnPointB.addEventListener('click', () => {
            if (!pointA) {
                showAlert("Peringatan", "Atur Titik Awal (A) terlebih dahulu!");
                return;
            }

            if (!lastKnownCoords) {
                showAlert("Mencari Sinyal GPS", "Mohon tunggu sejenak hingga posisi GPS terkunci.");
                return;
            }

            const photo = capturePhoto();
            pointB = {
                lat: lastKnownCoords.lat,
                lon: lastKnownCoords.lon,
                photo: photo
            };

            coordBText.textContent = `${pointB.lat.toFixed(5)}, ${pointB.lon.toFixed(5)}`;

            // UI Foto Preview B
            if (photo) {
                thumbBContainer.innerHTML = `<img src="${photo}" class="w-full h-full object-cover rounded-md">`;
                textPhotoBStatus.textContent = "Foto Terekam";
            }

            // Peta Marker B (Red Icon)
            if (markerB) map.removeLayer(markerB);

            const customIconB = L.divIcon({
                className: 'marker-pin-b',
                iconSize: [18, 18],
                iconAnchor: [9, 9]
            });

            markerB = L.marker([pointB.lat, pointB.lon], { icon: customIconB }).addTo(map)
                .bindPopup("<b>Titik Akhir (B)</b>").openPopup();

            // Kunci Garis Jalur
            pathCoords.push([pointB.lat, pointB.lon]);
            polyline.setLatLngs(pathCoords);

            // Zoom map fit bounds segmen A-B
            const bounds = L.latLngBounds([ [pointA.lat, pointA.lon], [pointB.lat, pointB.lon] ]);
            map.fitBounds(bounds, { padding: [30, 30] });

            // Hitung Jarak Final
            calculatedDistanceMeters = calculateDistanceTwoPoints(pointA.lat, pointA.lon, pointB.lat, pointB.lon);
            calculatedDistanceElem.innerHTML = `${calculatedDistanceMeters.toFixed(2)} <span class="text-base font-medium text-slate-300">meter</span>`;
            distanceKmSubElem.textContent = `(${(calculatedDistanceMeters / 1000).toFixed(3)} km)`;

            showAlert("Pengukuran Selesai", `Jarak segmen A ke B adalah ${calculatedDistanceMeters.toFixed(2)} meter.`);
        });

        // Hitung Jarak Haversine Formula
        function calculateDistanceTwoPoints(lat1, lon1, lat2, lon2) {
            const R = 6371000; // Earth radius in meters
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                      Math.sin(dLon / 2) * Math.sin(dLon / 2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return R * c;
        }

        // 6. Simpan Log Riwayat Pengukuran
        btnSaveLog.addEventListener('click', () => {
            const ruas = inputRuas.value.trim() || 'Ruas Tanpa Nama';
            const sta = inputSta.value.trim() || 'STA 0+000';
            const findingType = selectFindingType.value;
            const notes = inputNotes.value.trim() || '-';

            if (!pointA || !pointB) {
                showAlert("Data Belum Lengkap", "Harap tandai Titik A dan Titik B terlebih dahulu sebelum menyimpan log!");
                return;
            }

            const logItem = {
                id: Date.now(),
                timestamp: new Date().toLocaleString('id-ID'),
                ruas: ruas,
                sta: sta,
                findingType: findingType,
                distanceMeters: calculatedDistanceMeters.toFixed(2),
                distanceKm: (calculatedDistanceMeters / 1000).toFixed(3),
                coordA: `${pointA.lat.toFixed(6)}, ${pointA.lon.toFixed(6)}`,
                coordB: `${pointB.lat.toFixed(6)}, ${pointB.lon.toFixed(6)}`,
                photoA: pointA.photo,
                photoB: pointB.photo,
                notes: notes
            };

            monevLogs.unshift(logItem);
            renderLogs();

            // Reset Form Input
            inputNotes.value = '';
            showAlert("Berhasil Disimpan", `Data Monev segmen ${sta} telah ditambahkan ke riwayat.`);
        });

        // Render List Log ke Layar
        function renderLogs() {
            if (monevLogs.length === 0) {
                emptyLogMsg.classList.remove('hidden');
                return;
            }

            emptyLogMsg.classList.add('hidden');
            logListContainer.innerHTML = '';

            monevLogs.forEach(log => {
                const card = document.createElement('div');
                card.className = "bg-slate-950 border border-slate-800 p-3 rounded-xl space-y-2 text-xs";

                card.innerHTML = `
                    <div class="flex justify-between items-start border-b border-slate-800 pb-1.5">
                        <div>
                            <span class="font-extrabold text-amber-400 block">${log.ruas} (${log.sta})</span>
                            <span class="text-[10px] text-slate-500"><i class="fa-regular fa-clock mr-1"></i>${log.timestamp}</span>
                        </div>
                        <span class="bg-amber-500/10 border border-amber-500/30 text-amber-400 font-extrabold px-2 py-0.5 rounded-md text-[11px]">
                            ${log.distanceMeters} m
                        </span>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-300">
                        <div><b class="text-slate-500">Temuan:</b> ${log.findingType}</div>
                        <div><b class="text-slate-500">Catatan:</b> ${log.notes}</div>
                    </div>

                    <div class="flex items-center justify-between pt-1">
                        <div class="text-[9px] text-slate-500 font-mono space-y-0.5">
                            <div>A: ${log.coordA}</div>
                            <div>B: ${log.coordB}</div>
                        </div>
                        <div class="flex space-x-1">
                            ${log.photoA ? `<img src="${log.photoA}" class="w-8 h-8 object-cover rounded border border-slate-700" title="Foto A">` : ''}
                            ${log.photoB ? `<img src="${log.photoB}" class="w-8 h-8 object-cover rounded border border-slate-700" title="Foto B">` : ''}
                        </div>
                    </div>
                `;

                logListContainer.appendChild(card);
            });
        }

        // 7. Export Data ke File CSV
        document.getElementById('btn-export-csv').addEventListener('click', () => {
            if (monevLogs.length === 0) {
                showAlert("Export Gagal", "Belum ada riwayat data untuk diexport.");
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,";
            csvContent += "ID,Waktu,Nama Ruas,STA Segmen,Jarak (m),Jarak (km),Jenis Temuan,Koordinat A,Koordinat B,Catatan\n";

            monevLogs.forEach(item => {
                const row = [
                    item.id,
                    `"${item.timestamp}"`,
                    `"${item.ruas}"`,
                    `"${item.sta}"`,
                    item.distanceMeters,
                    item.distanceKm,
                    `"${item.findingType}"`,
                    `"${item.coordA}"`,
                    `"${item.coordB}"`,
                    `"${item.notes}"`
                ].join(",");
                csvContent += row + "\n";
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Laporan_Monev_Jalan_${Date.now()}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });

        // 8. Cetak PDF / Laporan Print Mode
        document.getElementById('btn-print-report').addEventListener('click', () => {
            if (monevLogs.length === 0) {
                showAlert("Print Gagal", "Belum ada riwayat data untuk dicetak.");
                return;
            }

            document.getElementById('print-date').textContent = new Date().toLocaleDateString('id-ID');
            const tbody = document.getElementById('print-table-body');
            tbody.innerHTML = '';

            monevLogs.forEach((item, idx) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="border border-black p-2 text-center">${idx + 1}</td>
                    <td class="border border-black p-2"><b>${item.ruas}</b><br>${item.sta}</td>
                    <td class="border border-black p-2 text-center">${item.distanceMeters} m</td>
                    <td class="border border-black p-2">${item.findingType}</td>
                    <td class="border border-black p-2 font-mono text-[10px]">A: ${item.coordA}<br>B: ${item.coordB}</td>
                    <td class="border border-black p-2">${item.notes}</td>
                `;
                tbody.appendChild(tr);
            });

            window.print();
        });

        // Modal Handlers
        const modalInfo = document.getElementById('modal-info');
        document.getElementById('btn-info').addEventListener('click', () => modalInfo.classList.remove('hidden'));
        document.getElementById('close-modal').addEventListener('click', () => modalInfo.classList.add('hidden'));
        document.getElementById('btn-close-modal').addEventListener('click', () => modalInfo.classList.add('hidden'));

        // Custom Alert Handlers
        function showAlert(title, message) {
            document.getElementById('alert-title').textContent = title;
            document.getElementById('alert-message').textContent = message;
            document.getElementById('custom-alert').classList.remove('hidden');
        }

        function closeCustomAlert() {
            document.getElementById('custom-alert').classList.add('hidden');
        }
    </script>
</body>
</html>
